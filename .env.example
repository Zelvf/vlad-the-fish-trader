# Preview mode uses clearly labelled scenario prices and sample paper trades.
APP_MODE=demo
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/vlad.sqlite

# A YouTube Live video ID, not the reference video's ID.
YOUTUBE_LIVE_VIDEO_ID=

# Required to accept computer-vision observations. Use a long random secret.
INGEST_TOKEN=

# For real reference quotes, set APP_MODE=live and both values below.
MARKET_DATA_PROVIDER=none
TWELVE_DATA_API_KEY=
QUOTE_POLL_MS=60000

# Trade policy
STARTING_CASH=10000
ORDER_NOTIONAL=500
DWELL_MS=5000
TRADE_COOLDOWN_MS=30000
MAX_QUOTE_AGE_MS=120000

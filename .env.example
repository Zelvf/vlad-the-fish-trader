# Preview mode uses clearly labelled scenario prices and sample paper trades.
APP_MODE=demo
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/vlad-memecoins.sqlite

# A YouTube Live video ID, not the reference video's ID.
YOUTUBE_LIVE_VIDEO_ID=

# Required to accept computer-vision observations. Use a long random secret.
INGEST_TOKEN=

# For independent crypto reference prices in live mode. A Demo key is recommended;
# keyless requests use a shared, less predictable IP rate limit.
MARKET_DATA_PROVIDER=none
COINGECKO_DEMO_API_KEY=
QUOTE_POLL_MS=300000

# Trade policy
STARTING_CASH=10000
ORDER_NOTIONAL=500
DWELL_MS=5000
TRADE_COOLDOWN_MS=30000
MAX_QUOTE_AGE_MS=600000
